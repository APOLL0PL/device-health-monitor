# ============================================
# Device Health Monitor — example variables
# ============================================

# ---- SERVER (server/.env, generated by serwer.sh) ----
# HTTP port (dashboard + API)
PORT=4000
# Token for WRITE operations (deleting devices, renaming, resolving alerts).
# Dashboard reads are open — NO login.
# Generate: openssl rand -hex 24
AUTH_TOKEN=
# Token required to register new agents (also: openssl rand -hex 24).
# Provide it in the setup-agent scripts on the devices.
REGISTER_TOKEN=

# ---- AGENT (environment variables / ecosystem) ----
# DHM server address
SERVER_URL=http://192.168.0.10:4000
# Device name shown on the dashboard (empty = hostname)
DEVICE_NAME=
# Type: server | desktop | laptop | phone | android
DEVICE_TYPE=server
# Reporting interval in seconds (empty = auto: phones 300, others 60)
REPORT_INTERVAL=
# Registration token from the server (required on first install if the server requires it)
REGISTER_TOKEN=
