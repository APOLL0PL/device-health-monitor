# Device Health Monitor - zmienne przykładowe

# --- SERWER (server/.env, generuje serwer.sh) ---
# Port HTTP (dashboard + API)
PORT=4000
# Token do operacji zapisu (usuwanie urządzeń, zmiana nazw, rozwiązywanie alertów).
# Odczyt dashboard jest otwarty - brak logowania.
# Generowanie: openssl rand -hex 24
AUTH_TOKEN=
# Token wymagany do rejestracji nowych agentów (też: openssl rand -hex 24).
# Podaj go w skryptach setup na urządzeniach.
REGISTER_TOKEN=

# --- AGENT (zmienne środowiskowe / ecosystem) ---
# Adres serwera DHM
SERVER_URL=http://192.168.0.10:4000
# Nazwa urządzenia na dashboardzie (puste = hostname)
DEVICE_NAME=
# Typ: server | desktop | laptop | phone | android
DEVICE_TYPE=server
# Interwał raportowania w sekundach (puste = auto: telefon 300, reszta 60)
REPORT_INTERVAL=
# Token rejestracji z serwera (wymagany przy pierwszej instalacji)
REGISTER_TOKEN=
